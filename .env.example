# Скопируйте этот файл в .env и заполните своими значениями.
# .env не должен попадать в git (см. .gitignore) — там ваш секретный API-токен.

# API-токен Omnidesk: Настройки -> Программисту -> API-ключ
OMNIDESK_API="your-omnidesk-api-token"

# Почта, под которой вы авторизуетесь в Omnidesk (логин агента)
EMAIL="you@example.com"

# Поддомен вашего Omnidesk-аккаунта: https://<SUBDOMAIN>.omnidesk.ru
SUBDOMAIN="your-subdomain"
