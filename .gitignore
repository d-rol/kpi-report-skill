# Креды Omni API
.env

# Дисковый кэш ответов API (содержит клиентские сообщения) и артефакты тестов
scripts/cache/
scripts/__pycache__/
__pycache__/
scripts/*.log
*.log

# Настройки калибровочной грации — содержат ваши группы и решения по ним.
# В репозитории лежит только calibration.example.json.
scripts/calibration.json

# График смен — содержит реальные staff_id и решения по конкретным дням.
# В репозитории лежит только shifts.example.json.
scripts/shifts.json

# Локальные прогоны/вывод отчётов
*_report.json
*_render.md
*_err.txt
*.html

# Отметка «первичная проверка установки пройдена» — локальная.
scripts/.setup_done

# ...но образцы отчётов в репозитории нужны — они на выдуманных данных.
!examples/*.html
